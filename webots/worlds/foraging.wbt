#VRML_SIM R2025a utf8
# Foraging arena for swarm-hazard Webots replication (spec 2026-10-23).
# Arena: 10 x 10 m, 20 Forager robots (robot0..robot19), one supervisor.
# Nest, patches and hazard are virtual (owned by the supervisor); coloured
# floor discs below are visual only (no collision geometry).
#
# Coordinate system: ENU (East-North-Up, z=up, gravity along -z).
#   x = East, y = North, z = Up.
#   Floor at z = 0 (x-y plane).  Robot bodies centred at z = 0.024 m.
#
# Time-step design: basicTimeStep = 20 ms; all controllers call step(100)
# so the behavioural control step is 100 ms = 0.1 s (= dt in the model).
# The supervisor passes each robot its desired heading every 100 ms.
#
# PROTO design: Forager is a local minimal differential-drive robot.
#   No internet EXTERNPROTO needed.  Body radius 0.037 m, height 0.040 m.
#   Two HingeJoint wheels (axis y), 8 IR distance sensors, Compass.
#   Matches the E-puck physical dimensions and motor names used by the
#   forager controller.

EXTERNPROTO "../protos/Forager.proto"

WorldInfo {
  info [
    "Swarm-hazard Webots replication (physics + collisions)."
    "10 x 10 m arena, 20 Forager robots, supervisor controller."
    "basicTimeStep 20 ms; control step 100 ms (= model dt 0.1 s)."
    "Local Forager PROTO: no internet downloads required."
    "Coordinate system: ENU (z up, gravity -z)."
  ]
  title "Swarm-hazard foraging arena"
  basicTimeStep 20
  coordinateSystem "ENU"
}
Viewpoint {
  orientation 0 1 0 0
  position 0 0 15
  near 0.05
  follow ""
}
Background {
  skyColor [
    0.4 0.7 1.0
  ]
}
# Light shines downward in ENU (direction = -z)
DirectionalLight {
  direction 0 0 -1
  intensity 0.8
  castShadows FALSE
}

# ---- Floor (10x10 m, thin box, top face at z=0) ----
Solid {
  name "floor"
  translation 0 0 -0.0005
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.82 0.72
        roughness 1.0
        metalness 0.0
      }
      geometry Box {
        size 10 10 0.001
      }
    }
  ]
  boundingObject Box {
    size 10 10 0.001
  }
}

# ---- Walls (0.02 m thick, 0.05 m tall, centred at z=0.025) ----
# North wall (y = +5.01), runs East-West (x-direction)
Solid {
  name "wall_north"
  translation 0 5.01 0.025
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 1.0 metalness 0.0 }
      geometry Box { size 10 0.02 0.05 }
    }
  ]
  boundingObject Box { size 10 0.02 0.05 }
}
# South wall (y = -5.01)
Solid {
  name "wall_south"
  translation 0 -5.01 0.025
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 1.0 metalness 0.0 }
      geometry Box { size 10 0.02 0.05 }
    }
  ]
  boundingObject Box { size 10 0.02 0.05 }
}
# East wall (x = +5.01), runs North-South (y-direction)
Solid {
  name "wall_east"
  translation 5.01 0 0.025
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 1.0 metalness 0.0 }
      geometry Box { size 0.02 10 0.05 }
    }
  ]
  boundingObject Box { size 0.02 10 0.05 }
}
# West wall (x = -5.01)
Solid {
  name "wall_west"
  translation -5.01 0 0.025
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 1.0 metalness 0.0 }
      geometry Box { size 0.02 10 0.05 }
    }
  ]
  boundingObject Box { size 0.02 10 0.05 }
}

# ---- Visual-only floor markers (no collision, no physics) ----
# In ENU, Cylinder axis = z (Up) by default — cylinders are upright.
# No rotation needed; z=0.001 = just above floor.
#
# Coordinate mapping: webots_to_sim(wx,wy) = (wx+5, wy+5)
#   wx = East (x), wy = North (y).
#
# Nest: sim(5,5) = Webots(0,0)
Transform {
  translation 0 0 0.001
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.2 0.8 0.2
          transparency 0.4
        }
      }
      geometry Cylinder {
        height 0.001
        radius 0.75
      }
    }
  ]
}
# Patch NW: sim(2.5,2.5) = Webots(-2.5,-2.5)
Transform {
  translation -2.5 -2.5 0.001
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.8 0.1
          transparency 0.4
        }
      }
      geometry Cylinder {
        height 0.001
        radius 0.75
      }
    }
  ]
}
# Patch NE: sim(7.5,2.5) = Webots(2.5,-2.5)
Transform {
  translation 2.5 -2.5 0.001
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.8 0.1
          transparency 0.4
        }
      }
      geometry Cylinder {
        height 0.001
        radius 0.75
      }
    }
  ]
}
# Patch SW: sim(2.5,7.5) = Webots(-2.5,2.5)
Transform {
  translation -2.5 2.5 0.001
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.8 0.1
          transparency 0.4
        }
      }
      geometry Cylinder {
        height 0.001
        radius 0.75
      }
    }
  ]
}
# Patch SE: sim(7.5,7.5) = Webots(2.5,2.5)
Transform {
  translation 2.5 2.5 0.001
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.8 0.1
          transparency 0.4
        }
      }
      geometry Cylinder {
        height 0.001
        radius 0.75
      }
    }
  ]
}
# Hazard: sim(8.81,6.19) = Webots(3.81,1.19)
Transform {
  translation 3.81 1.19 0.001
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.1 0.1
          transparency 0.5
        }
      }
      geometry Cylinder {
        height 0.001
        radius 1.0
      }
    }
  ]
}
# ---- Supervisor (no physical body) ----
# controllerArgs: "CONTROLLER SEED OUT_CSV N_STEPS" - replaced by run_webots.py per run.
# Default values below are for ad-hoc manual runs.
DEF SUPERVISOR Robot {
  name "supervisor"
  controller "supervisor"
  controllerArgs [
    "C2"
    "0"
  ]
  supervisor TRUE
  synchronization TRUE
}
# ---- 20 Forager robots, placed in a circle (r=2.0 m) around the nest ----
# In ENU: translation = (x_East, y_North, 0.024).
# Old NUE was (x_North, 0.024, z_East); new ENU = (z_East, x_North, 0.024).
# Body centre at z=0.024; wheel bottom at z=0.000 (floor contact). ✓
DEF ROBOT0 Forager {
  translation 0.0000 2.0000 0.024
  name "robot0"
  controller "forager"
  synchronization TRUE
}
DEF ROBOT1 Forager {
  translation 0.6180 1.9021 0.024
  name "robot1"
  controller "forager"
  synchronization TRUE
}
