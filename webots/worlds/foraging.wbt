#VRML_SIM R2025a utf8
# Foraging arena for swarm-hazard Webots replication (spec 2026-10-23).
# Arena: 10 x 10 m, 20 Forager robots (robot0..robot19), one supervisor.
# Nest, patches and hazard are virtual (owned by the supervisor); coloured
# floor discs below are visual only (no collision geometry).
#
# Time-step design: basicTimeStep = 20 ms; all controllers call step(100)
# so the behavioural control step is 100 ms = 0.1 s (= dt in the model).
# The supervisor passes each robot its desired heading every 100 ms.
#
# PROTO design: Forager is a local minimal differential-drive robot.
#   No internet EXTERNPROTO needed.  Body radius 0.037 m, height 0.048 m.
#   Two HingeJoint wheels, 8 IR distance sensors, Compass.
#   Matches the E-puck physical dimensions and motor names used by the
#   forager controller.

EXTERNPROTO "../protos/Forager.proto"

WorldInfo {
  info [
    "Swarm-hazard Webots replication (physics + collisions)."
    "10 x 10 m arena, 20 Forager robots, supervisor controller."
    "basicTimeStep 20 ms; control step 100 ms (= model dt 0.1 s)."
    "Local Forager PROTO: no internet downloads required."
  ]
  title "Swarm-hazard foraging arena"
  basicTimeStep 20
  coordinateSystem "NUE"
}
Viewpoint {
  orientation 0 1 0 0
  position 0 15 0
  near 0.05
  follow ""
}
# ---- Background light (inline, no EXTERNPROTO needed) ----
Background {
  skyColor [
    0.4 0.7 1.0
  ]
}
DirectionalLight {
  direction 0 -1 0
  intensity 0.8
  castShadows FALSE
}

# ---- Floor (10x10 m, solid) ----
Solid {
  name "floor"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.82 0.72
        roughness 1.0
        metalness 0.0
      }
      geometry Plane {
        size 10 10
      }
    }
  ]
  boundingObject Plane {
    size 10 10
  }
}

# ---- Walls (four thin boxes, 10 m long, 0.05 m high, 0.02 m thick) ----
# North wall (x = +5)
Solid {
  name "wall_north"
  translation 5.01 0.025 0
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 1.0 metalness 0.0 }
      geometry Box { size 0.02 0.05 10 }
    }
  ]
  boundingObject Box { size 0.02 0.05 10 }
}
# South wall (x = -5)
Solid {
  name "wall_south"
  translation -5.01 0.025 0
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 1.0 metalness 0.0 }
      geometry Box { size 0.02 0.05 10 }
    }
  ]
  boundingObject Box { size 0.02 0.05 10 }
}
# East wall (z = +5)
Solid {
  name "wall_east"
  translation 0 0.025 5.01
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 1.0 metalness 0.0 }
      geometry Box { size 10 0.05 0.02 }
    }
  ]
  boundingObject Box { size 10 0.05 0.02 }
}
# West wall (z = -5)
Solid {
  name "wall_west"
  translation 0 0.025 -5.01
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.6 0.6 0.6 roughness 1.0 metalness 0.0 }
      geometry Box { size 10 0.05 0.02 }
    }
  ]
  boundingObject Box { size 10 0.05 0.02 }
}

# ---- Visual-only floor markers (no collision, no physics) ----
# Nest: green disc, centre (0, 0) in Webots = (5, 5) in sim coords, radius 0.75 m
Transform {
  translation 0 0.001 0
  rotation 1 0 0 -1.5707963267948966
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.2 0.8 0.2
          transparency 0.4
        }
      }
      geometry Cylinder {
        height 0.001
        radius 0.75
      }
    }
  ]
}
# Patch NW: (-2.5, 0.001, -2.5) = sim (2.5, 2.5)
Transform {
  translation -2.5 0.001 -2.5
  rotation 1 0 0 -1.5707963267948966
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.8 0.1
          transparency 0.4
        }
      }
      geometry Cylinder {
        height 0.001
        radius 0.75
      }
    }
  ]
}
# Patch NE: (2.5, 0.001, -2.5) = sim (7.5, 2.5)
Transform {
  translation 2.5 0.001 -2.5
  rotation 1 0 0 -1.5707963267948966
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.8 0.1
          transparency 0.4
        }
      }
      geometry Cylinder {
        height 0.001
        radius 0.75
      }
    }
  ]
}
# Patch SW: (-2.5, 0.001, 2.5) = sim (2.5, 7.5)
Transform {
  translation -2.5 0.001 2.5
  rotation 1 0 0 -1.5707963267948966
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.8 0.1
          transparency 0.4
        }
      }
      geometry Cylinder {
        height 0.001
        radius 0.75
      }
    }
  ]
}
# Patch SE: (2.5, 0.001, 2.5) = sim (7.5, 7.5)
Transform {
  translation 2.5 0.001 2.5
  rotation 1 0 0 -1.5707963267948966
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.8 0.1
          transparency 0.4
        }
      }
      geometry Cylinder {
        height 0.001
        radius 0.75
      }
    }
  ]
}
# Hazard: red disc at (3.81, 0.001, 1.19) = sim (8.81, 6.19), radius 1.0 m
Transform {
  translation 3.81 0.001 1.19
  rotation 1 0 0 -1.5707963267948966
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.1 0.1
          transparency 0.5
        }
      }
      geometry Cylinder {
        height 0.001
        radius 1.0
      }
    }
  ]
}
# ---- Supervisor (no physical body) ----
# controllerArgs: "CONTROLLER SEED OUT_CSV N_STEPS" - replaced by run_webots.py per run.
# Default values below are for ad-hoc manual runs.
DEF SUPERVISOR Robot {
  name "supervisor"
  controller "supervisor"
  controllerArgs [
    "C2"
    "0"
  ]
  supervisor TRUE
  synchronization TRUE
}
# ---- 20 Forager robots, placed in a circle (r=2.0 m) around the nest ----
# Positions in Webots (x, y=0.024, z); Arena origin = sim (5,5).
# y=0.024 m = body half-height, so the floor contact is at y=0.
DEF ROBOT0 Forager {
  translation 2.0000 0.024 0.0000
  name "robot0"
  controller "forager"
  synchronization TRUE
}
